rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 지도 데이터 파일들은 공개 읽기 허용
    match /korea-*.json {
      allow read: if true;
      allow write: if request.auth != null && 
        (request.auth.token.role == 'admin' || request.auth.token.role == 'master');
    }
    
    // 기타 모든 파일
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && 
        (request.auth.token.role == 'admin' || request.auth.token.role == 'master');
    }
  }
} 