# Firebase 설정
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# 날씨 API 키 (기상청 공공데이터 포털)
VITE_WEATHER_API_KEY=your_weather_api_key_here

# 네이버 API 키 (뉴스 검색)
VITE_NAVER_CLIENT_ID=your_naver_client_id_here
VITE_NAVER_CLIENT_SECRET=your_naver_client_secret_here

# OpenAI API 키 (AI 기능, 선택사항)
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Google Tasks API (선택사항)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# 마스터 권한 (쉼표 구분으로 여러 명 가능)
VITE_MASTER_EMAIL=master@yourcompany.com
# VITE_MASTER_EMAILS=email1@a.com,email2@b.com
# VITE_MASTER_UIDS=firebase_uid_1,firebase_uid_2

# Google Maps API (선택사항)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 개발 환경 설정
VITE_API_URL=http://localhost:3001/api
VITE_USE_FIRESTORE_EMULATOR=false

# NAS API URL (HTTPS)
VITE_NAS_API_URL=https://chunwoo.iptime.org