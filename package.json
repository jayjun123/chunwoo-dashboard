{
  "name": "my-project",
  "version": "0.1.0",
  "description": "현장관리 시스템 - Firebase 기반 현장 관리 애플리케이션",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "dependencies": {
    "@capacitor/android": "^7.4.1",
    "@capacitor/cli": "^7.4.1",
    "@capacitor/core": "^7.4.1",
    "@capacitor/ios": "^7.4.1",
    "@capacitor/keyboard": "^7.0.1",
    "@date-io/date-fns": "^3.2.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@firebase/analytics": "^0.10.16",
    "@firebase/app": "^0.13.1",
    "@firebase/auth": "^1.10.6",
    "@firebase/firestore": "^4.7.17",
    "@firebase/storage": "^0.13.12",
    "@hello-pangea/dnd": "^16.6.0",
    "@mui/icons-material": "^7.1.1",
    "@mui/material": "^7.1.1",
    "@mui/x-date-pickers": "^8.10.2",
    "@reduxjs/toolkit": "^2.8.2",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/node": "^24.0.3",
    "@vitejs/plugin-react": "^4.5.1",
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.4.9",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.5.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "exceljs": "^4.3.0",
    "express": "^5.1.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.4.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "mongoose": "^8.15.1",
    "prettier": "^3.6.2",
    "react": "^18.2.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-big-calendar": "^1.19.2",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "react-firebase-hooks": "^5.1.1",
    "react-icons": "^5.5.0",
    "react-leaflet": "^4.2.1",
    "react-redux": "^9.2.0",
    "react-responsive": "^10.0.1",
    "react-router-dom": "^6.30.1",
    "react-scripts": "^5.0.1",
    "react-toastify": "^10.0.6",
    "react-touch-drag-slider": "^2.2.6",
    "recharts": "^2.15.4",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vite-plugin-pwa": "^0.20.5",
    "web-vitals": "^2.1.4",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "npx electron .",
    "electron:dev": "npm run build && npx electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:dist": "npm run build && electron-builder --publish=never",
    "electron:pack": "npm run build && electron-builder --dir",
    "test": "react-scripts test",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "test:ci": "react-scripts test --coverage --watchAll=false --ci",
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "eject": "react-scripts eject",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write src/**/*.{js,jsx,ts,tsx,css,md}",
    "type-check": "tsc --noEmit",
    "migrate-status": "node -e \"import('./src/scripts/migrateSiteStatus.js').then(m => m.migrateSiteStatus())\"",
    "clean": "rm -rf dist node_modules/.cache",
    "clean:all": "rm -rf dist node_modules package-lock.json && npm install",
    "serve": "npm run build && npm run preview",
    "docker:build": "docker build -t myproject .",
    "docker:run": "docker run -p 3000:3000 myproject",
    "firebase:login": "firebase login",
    "firebase:init": "firebase init",
    "upload:templates": "node upload_new_templates.js",
    "firebase:deploy": "npm run build && firebase deploy",
    "firebase:deploy:hosting": "npm run build && firebase deploy --only hosting",
    "firebase:deploy:firestore": "firebase deploy --only firestore",
    "firebase:deploy:storage": "firebase deploy --only storage",
    "firebase:emulators": "firebase emulators:start",
    "firebase:emulators:export": "firebase emulators:export ./emulator-data",
    "firebase:emulators:import": "firebase emulators:start --import=./emulator-data",
    "netlify:deploy": "npm run build && netlify deploy --prod --dir=dist",
    "netlify:deploy:preview": "npm run build && netlify deploy --dir=dist",
    "capacitor:add": "npx cap add",
    "capacitor:sync": "npx cap sync",
    "capacitor:copy": "npx cap copy",
    "capacitor:open:android": "npx cap open android",
    "capacitor:open:ios": "npx cap open ios",
    "capacitor:build:android": "npm run build && npx cap sync && npx cap build android",
    "capacitor:build:ios": "npm run build && npx cap sync && npx cap build ios",
    "android:build:debug": "npm run capacitor:build:android && cd android && ./gradlew assembleDebug",
    "android:build:release": "npm run capacitor:build:android && cd android && ./gradlew assembleRelease",
    "android:bundle:release": "npm run capacitor:build:android && cd android && ./gradlew bundleRelease",
    "ios:build": "npm run capacitor:build:ios && cd ios && xcodebuild -workspace App.xcworkspace -scheme App -configuration Release -destination generic/platform=iOS archive -archivePath App.xcarchive",
    "ios:ipa": "npm run ios:build && cd ios && xcodebuild -exportArchive -archivePath App.xcarchive -exportOptionsPlist exportOptions.plist -exportPath ./build",
    "deploy:all": "npm run build && npm run firebase:deploy && npm run netlify:deploy",
    "release:android": "npm run android:bundle:release",
    "release:ios": "npm run ios:ipa"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "@craco/craco": "^7.1.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "babel-jest": "^29.7.0",
    "compression-webpack-plugin": "^10.0.0",
    "concurrently": "^9.2.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prop-types": "^15.8.1",
    "source-map-explorer": "^2.5.3",
    "terser-webpack-plugin": "^5.3.10",
    "wait-on": "^8.0.4",
    "webpack-bundle-analyzer": "^4.10.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "build": {
    "appId": "com.chunwoo.fieldmanagement",
    "productName": "현장관리 시스템",
    "directories": {
      "output": "electron-dist"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "현장관리 시스템"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/myproject.git"
  },
  "keywords": [
    "react",
    "firebase",
    "construction",
    "management",
    "typescript",
    "material-ui"
  ],
  "author": "Your Name",
  "license": "MIT"
}
